{
  "name": "openevidence-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server that connects OpenEvidence to AI agents via the user's authenticated browser session",
  "main": "dist/server.js",
  "bin": {
    "openevidence-mcp": "./dist/server.js"
  },
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "login": "tsx src/login.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/smoke.ts"
  },
  "files": [
    "dist/",
    "scripts/",
    "examples/",
    "docs/DIRECTORY_COPY.md",
    "docs/TROUBLESHOOTING.md",
    ".env.example",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.ru.md",
    "README.es.md",
    "README.zh-Hans.md",
    "README.hi.md",
    "README.AI.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openevidence",
    "medical-ai",
    "clinical-research",
    "healthcare-ai",
    "ai-agents",
    "codex",
    "codex-cli",
    "claude-code",
    "claude-desktop",
    "claude",
    "cursor",
    "cline",
    "continue",
    "github-copilot",
    "playwright",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bakhtiersizhaev/openevidence-mcp.git"
  },
  "homepage": "https://bakhtiersizhaev.github.io/openevidence-mcp/",
  "bugs": {
    "url": "https://github.com/bakhtiersizhaev/openevidence-mcp/issues"
  },
  "author": "Bakhtier Sizhaev",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^17.3.1",
    "playwright": "^1.58.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
